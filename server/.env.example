# Copy to .env and change the passwords before running anything public.
KM_SERVER_NAME=Kingmakers RP
KM_PORT=7777
KM_MAX_PLAYERS=100
# Leave empty to disable RCON.
KM_RCON_PASSWORD=
# Your account name (as typed in the app). It becomes owner (level 5) when it
# logs in or registers.
KM_OWNER_ACCOUNT=
# Server content (server/content/, see docs/CONTENT.md): the app downloads
# it from this server on TCP port KM_CONTENT_PORT. KM_CONTENT_URL is its
# public address, as players reach it; deploy.sh fills it in if it's empty.
KM_CONTENT_PORT=7780
KM_CONTENT_URL=
# A sound from server/content/ played after login, e.g. sounds/welcome.mp3.
KM_WELCOME_SOUND=
# true lists the server on the open.mp master list.
KM_ANNOUNCE=false

# Database backups (data/backups): how many to keep, hours between them.
KM_BACKUP_KEEP=14
KM_BACKUP_INTERVAL_HOURS=24

DB_NAME=kingmakers
DB_USER=kingmakers
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root
